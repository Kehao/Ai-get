# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node / 前端构建产物 ───────────────────────────────────────────────────
node_modules/
dist/
*.tsbuildinfo
.vite/

# ── 本地参考素材 ──────────────────────────────────────────────────────────
# 参考站快照（页面截图与正文抓取），仅用于本地对照，不随仓库分发。
.ref/

# ── 工具与编辑器 ──────────────────────────────────────────────────────────
.workbuddy/
.vscode/
.idea/

# ── 系统与临时文件 ────────────────────────────────────────────────────────
.DS_Store
*.log
*.local

# ── 机密配置 ──────────────────────────────────────────────────────────────
# 密钥只放在 .env 里；.env.example 是不含密钥的模板，必须能提交，
# 否则新人不知道有哪些开关可配。
.env
.env.*
!.env.example
