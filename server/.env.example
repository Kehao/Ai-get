# ── Ai-get 配置模板 ───────────────────────────────────────────────────────
#
# 用法：复制成 `.env` 再填自己的值。
#   cp server/.env.example server/.env
#
# `.env` 已被根目录 .gitignore 排除，**密钥只放在 .env 里**，不要写进源码。

# ── 数据源 ────────────────────────────────────────────────────────────────
AIGET_DATA_SOURCE=mock
# 接真实源（P4/P5）：配置 key 后对应源自动注册；切默认源用 AIGET_DATA_SOURCE。
#   Tavily（网页召回）：https://tavily.com，免费层每月 1000 credits。
#   PDL（企业字段补齐）：https://peopledatalabs.com，免费层每月 100 credits（仅 base 字段）。
# AIGET_TAVILY_API_KEY=
# AIGET_PDL_API_KEY=

# ── LLM（L0 资格标准引擎）──────────────────────────────────────────────
#
# 开关：false 时完全走规则引擎，进程不产生任何外部请求。
AIGET_LLM_ENABLED=false

# 任何 OpenAI 兼容端点都可以：DeepSeek / 通义 / 火山 / 自建网关。
AIGET_LLM_BASE_URL=https://api.deepseek.com

# DeepSeek 官方 API 的模型名是 deepseek-flash 或 deepseek-v4-pro。
# 别名 deepseek-chat 等价于 deepseek-flash。
AIGET_LLM_MODEL=deepseek-flash

# 单次调用超时（秒）。超时自动降级到规则引擎，不会阻塞任务创建。
AIGET_LLM_TIMEOUT_SECONDS=30

# 单次调用的输出上限。它是**上限不是目标**，正常输出用不到；
# 长画像偶发触发过截断导致整批标准降级，所以留宽一点。
AIGET_LLM_MAX_TOKENS=4096

# L3 逐条判定的 LLM 兜底。⚠️ 尚未实现：打开它目前不会改变任何行为，
# 判定仍走规则，后端启动时会打一条 warning。留在这里是为了说明设计意图。
# 实现后调用量会很大：一个 25 家的列表 × 每家的标准条数 = 上百次调用。
AIGET_LLM_JUDGE_ENABLED=false

# 提示词技能目录。L0 的提示词与契约不在代码里，而在这个目录中：
#   <dir>/contract.json                 ★ 唯一真源：维度枚举、上限、expected 契约、版本号
#   <dir>/prompts/criteria.system.md    system 骨架（只含 $占位符）
#   <dir>/prompts/criteria.user.md      user 骨架
# 相对路径以**仓库根**为基准解析。换领域时指向另一份技能目录即可，不必改代码。
# 目录缺文件、或契约与规则引擎的表不一致时会**直接启动失败**（PromptAssetError）——
# 这是有意为之：提示词是仓库资产，缺失属于检出损坏，不该静默降级成「LLM 看起来在工作」。
AIGET_LLM_PROMPT_DIR=skills/profile-to-company-criteria

# 找人模式的提示词契约目录。人物维度（姓名/职位/职级…）与会社不重叠，
# 是**另一份契约**（skills/profile-to-person-criteria/）。留空即用默认值。
AIGET_LLM_PERSON_PROMPT_DIR=

AIGET_LLM_API_KEY=
